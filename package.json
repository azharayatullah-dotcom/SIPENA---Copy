{
  "name": "sipena",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate --schema prisma/schema.local.prisma && next dev",
    "build": "prisma generate --schema prisma/schema.prisma && prisma migrate deploy --schema prisma/schema.prisma && next build",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "start": "next start",
    "db:migrate": "prisma db push --schema prisma/schema.local.prisma",
    "db:seed": "prisma db seed --schema prisma/schema.local.prisma",
    "db:studio": "prisma studio --schema prisma/schema.local.prisma"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "2.4.3",
    "framer-motion": "^11.18.2",
    "jose": "5.10.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.30",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.3",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.3",
    "typescript": "5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
